# Optional: copy to .env to override defaults (cp .env.example .env).

# --- Postgres (superuser, used only to bootstrap the databases below) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Application database ---
APP_DB_NAME=kwot
APP_DB_USER=kwot
APP_DB_PASSWORD=kwot

# --- Keycloak database ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak

# --- Keycloak admin console (http://localhost:8080/admin) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# --- Assistant (turns the customer's description into a request document) ---
# "ollama" runs an open-weights model locally (default); "anthropic" uses Claude.
ASSISTANT_PROVIDER=ollama

# Ollama: the `ollama` container by default (CPU only on macOS). For a native Ollama
# on the host (uses the Apple GPU), set OLLAMA_BASE_URL=http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Claude (only used when ASSISTANT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

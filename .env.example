# Optional: copy to .env to override defaults (cp .env.example .env).

# --- Postgres (superuser, used only to bootstrap the databases below) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Application database ---
APP_DB_NAME=kwot
APP_DB_USER=kwot
APP_DB_PASSWORD=kwot

# --- Keycloak database ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak

# --- Keycloak admin console (http://localhost:8080/admin) ---
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# --- Assistant (chat-based request intake) ---
# Leave empty to run without the chat assistant; the form flow still works.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
